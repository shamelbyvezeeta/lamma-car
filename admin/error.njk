{% extends "layouts/admin.njk" %}
{% from "partials/icons.njk" import icon %}
{% block title %}{{ t('errors.title') }}{% endblock %}
{% block content %}
<section class="card card-pad" style="max-width:620px;margin:3rem auto;text-align:center">
  <div class="muted num" style="font-size:3rem;font-weight:800;color:var(--coral)">{{ status }}</div>
  <h1 style="font-size:1.35rem;margin:.4rem 0">{{ t(messageKey, params) }}</h1>
  <p class="muted">{{ t('errors.admin_hint') }}</p>
  <div class="actions" style="justify-content:center"><a class="btn btn-primary" href="/admin">{{ t('nav.dashboard') }}</a></div>
</section>
{% endblock %}
