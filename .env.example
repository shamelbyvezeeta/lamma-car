# ---------------------------------------------------------------------------
# Lamma Car — environment variables. Copy to .env (never commit real values).
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# PostgreSQL 14+ connection string. Use a dedicated role that owns the database.
DATABASE_URL=postgres://lamma_app:CHANGE_ME@db.internal:5432/lamma_car
# Set to true when the database requires TLS (most managed Postgres services).
DATABASE_SSL=true
DB_POOL_MAX=10

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The base URL encoded into every printed QR code, WITHOUT the trailing code.
# !!! PRINTED INTO STICKERS — it can never change after the first batch is printed. !!!
# Must be https in production. Keep it short (≤ 30 chars incl. /q) for larger QR modules.
QR_BASE_URL=https://car.example.com/q

# Public origin of this app (used in links/emails if added later)
APP_BASE_URL=https://car.example.com

# Number of reverse proxies in front of the app (for correct client IPs / rate limiting / secure cookies).
TRUST_PROXY=1

# Where vehicle photos are stored (persistent volume). Default: ./storage
STORAGE_DIR=/var/lib/lamma-car/storage

# Salt for hashing visitor IPs on contact requests (defaults to SESSION_SECRET)
IP_HASH_SALT=

# Rate limits (per client IP)
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_CONTACT_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_15MIN=10

# Time zone used for dates in the UI and reports
APP_TIMEZONE=Africa/Cairo

# Spot colour names expected by the print shop's RIP (ask the printer)
STICKER_WHITE_SPOT_NAME=White
STICKER_CUT_SPOT_NAME=CutContour

# One-time first admin setup (optional; otherwise the password is prompted)
# LAMMA_ADMIN_PASSWORD=
