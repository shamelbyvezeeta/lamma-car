{% extends "layouts/public.njk" %}
{% block robots %}index, follow{% endblock %}
{% block title %}Lamma Car — Find it. Sell it. Easy.{% endblock %}
{% block content %}
<section class="home-hero">
  <img src="/static/brand/lamma-car-logo.png" alt="Lamma Car — Find it. Sell it. Easy." width="1506" height="577">
  <p>{{ t('public.home_intro') }}</p>
</section>
<div class="steps">
  <div class="step"><i>1</i><div><b>{{ t('public.step1_t') }}</b><span>{{ t('public.step1') }}</span></div></div>
  <div class="step"><i>2</i><div><b>{{ t('public.step2_t') }}</b><span>{{ t('public.step2') }}</span></div></div>
  <div class="step"><i>3</i><div><b>{{ t('public.step3_t') }}</b><span>{{ t('public.step3') }}</span></div></div>
</div>
<p class="small muted" style="text-align:center;margin-top:22px"><a href="/admin/login">{{ t('public.staff_login') }}</a></p>
{% endblock %}
